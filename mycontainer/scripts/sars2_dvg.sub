# ==============================================================================
# HTCondor Submit File: SARS-CoV-2 Deletion Detection Pipeline (Single-Sample Queue)
# ==============================================================================

# Container Configuration (per CHTC guide: universe = container)
universe                = container
container_image         = docker://szarr1/sars2_dvg:v1

# Script to run inside container and its arguments
executable              = run_sample_condor.sh
arguments               = $(RUN_ID) $(PRIMER_VER) $(CPUS)

# Logging: per-sample logs stored in logs/ directory
log                     = logs/$(RUN_ID).log
output                  = logs/$(RUN_ID).out
error                   = logs/$(RUN_ID).err

# File Transfer Settings:
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

# Stage the pre-downloaded .sra file to worker node scratch
transfer_input_files    = staged_sra/$(RUN_ID).sra, staged_sra/$(RUN_ID).sra, run_pipeline.sh

# Only transfer back meaningful results and logs
transfer_output_files   = filtered_$(RUN_ID)_0.01_5_20_2_34.txt, \
                          filtered_$(RUN_ID)_annotated_standardizationAligned.deletion.sorted.txt, \
                          filtered_$(RUN_ID)_annotated_standardizationAligned.out.sorted.coverage, \
                          $(RUN_ID)_pipeline.log

# Resource Requests per Sample:
CPUS                    = 1
request_cpus            = $(CPUS)
request_memory          = 4GB
request_disk            = 10GB
retry_request_disk = 25 GB

# Queue 1 job per sample from the TSV manifest
queue RUN_ID, PRIMER_VER, PROTOCOL_VER from coguk_illumina_paired_artic.tsv
