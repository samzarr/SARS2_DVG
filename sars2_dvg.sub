# ==============================================================================
# HTCondor Submit File: SARS-CoV-2 Deletion Detection Pipeline
# Designed to be submitted directly from the project root directory
# ==============================================================================

# Container Configuration (CHTC container universe)
universe                = container
container_image         = docker://szarr1/sars2_dvg:v1

# Script to run inside container and its arguments
executable              = mycontainer/scripts/run_sample_condor.sh
arguments               = $(RUN_ID) $(PRIMER_VER) $(CPUS)

# Logging: per-sample HTCondor event log and stderr stored in logs/
log                     = logs/$(RUN_ID).log
error                   = logs/$(RUN_ID).err
# Suppress duplicate .out file since $(RUN_ID)_pipeline.log is transferred directly
output                  = /dev/null

# File Transfer Settings
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

transfer_input_files    = mycontainer/scripts/run_pipeline.sh

# Transfer results back from worker scratch
transfer_output_files   = filtered_$(RUN_ID)_0.01_5_20_2_34.txt, $(RUN_ID)_pipeline.log
transfer_output_remaps  = "filtered_$(RUN_ID)_0.01_5_20_2_34.txt = outputs/filtered_$(RUN_ID)_0.01_5_20_2_34.txt; $(RUN_ID)_pipeline.log = logs/$(RUN_ID)_pipeline.log"

# Resource Requests per Sample
CPUS                    = 1
request_cpus            = $(CPUS)
request_memory          = 4GB
request_disk            = 10GB
retry_request_disk      = 25GB

# Queue 1 job per sample from the TSV manifest
queue RUN_ID, PRIMER_VER, PROTOCOL_VER from coguk100.tsv
